+package eu.europa.ec.simpl.identityprovider.liquibase;
+
+import org.springframework.beans.factory.config.BeanFactoryPostProcessor;
+import org.springframework.beans.factory.config.ConfigurableListableBeanFactory;
+import org.springframework.context.ApplicationContext;
+import org.springframework.context.ApplicationContextAware;
+import org.springframework.context.ConfigurableApplicationContext;
+import org.springframework.stereotype.Component;
+
+/**
+ * Exposes the running application context to Liquibase custom changes, which Liquibase
+ * instantiates itself and which therefore cannot be injected. Being a bean factory
+ * post-processor, this bean is created (and handed the context) before any singleton,
+ * so the context is available by the time the Liquibase bean runs the changelog. This
+ * replaces booting a second SpringApplication from inside the first one, which also
+ * cannot work in AOT/native mode.
+ */
+@Component
+public class MainApplicationContextHolder implements BeanFactoryPostProcessor, ApplicationContextAware {
+
+    private static volatile ConfigurableApplicationContext applicationContext;
+
+    @Override
+    public void setApplicationContext(ApplicationContext context) {
+        if (context instanceof ConfigurableApplicationContext configurable) {
+            set(configurable);
+        }
+    }
+
+    @Override
+    public void postProcessBeanFactory(ConfigurableListableBeanFactory beanFactory) {
+        // Nothing to post-process: implemented only so the context is handed over early.
+    }
+
+    static ConfigurableApplicationContext get() {
+        return applicationContext;
+    }
+
+    static void set(ConfigurableApplicationContext context) {
+        applicationContext = context;
+    }
+}
