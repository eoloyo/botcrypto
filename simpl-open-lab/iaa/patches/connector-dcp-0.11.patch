index 0000000..5b19198
--- /dev/null
+++ b/src/main/java/eu/europa/ec/simpl/dcp/SimplDcpExtension.java
@@ -0,0 +1,131 @@
+package eu.europa.ec.simpl.dcp;
+
+import eu.europa.ec.simpl.iam.jwt.IdentityAttribute;
+import org.eclipse.edc.iam.identitytrust.spi.ClaimTokenCreatorFunction;
+import org.eclipse.edc.iam.verifiablecredentials.spi.model.CredentialSubject;
+import org.eclipse.edc.iam.verifiablecredentials.spi.model.VerifiableCredential;
+import org.eclipse.edc.policy.context.request.spi.RequestCatalogPolicyContext;
+import org.eclipse.edc.policy.context.request.spi.RequestContractNegotiationPolicyContext;
+import org.eclipse.edc.policy.context.request.spi.RequestTransferProcessPolicyContext;
+import org.eclipse.edc.policy.context.request.spi.RequestVersionPolicyContext;
+import org.eclipse.edc.policy.engine.spi.PolicyEngine;
+import org.eclipse.edc.runtime.metamodel.annotation.Extension;
+import org.eclipse.edc.runtime.metamodel.annotation.Inject;
+import org.eclipse.edc.runtime.metamodel.annotation.Provider;
+import org.eclipse.edc.spi.iam.ClaimToken;
+import org.eclipse.edc.spi.monitor.Monitor;
+import org.eclipse.edc.spi.result.Result;
+import org.eclipse.edc.spi.system.ServiceExtension;
+import org.eclipse.edc.spi.system.ServiceExtensionContext;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Binds Simpl's Tier-2 identity to DCP.
+ * <ul>
+ *   <li>Every outgoing and incoming DSP request (catalog, negotiation, transfer, version) asks for the
+ *   Simpl membership credential scope, so the counterparty must present a verifiable
+ *   SimplDataspaceMembershipCredential.</li>
+ *   <li>The verified credential's claims become the participant agent's claims: {@code client_id} (the
+ *   credential subject DID) and {@code identity_attributes}, which Simpl's existing ABAC functions read.
+ *   Simpl policies such as {@code edc:consumption} therefore run unchanged, on DCP-verified data.</li>
+ * </ul>
+ */
+@Extension(value = SimplDcpExtension.NAME)
+public class SimplDcpExtension implements ServiceExtension {
+
+    public static final String NAME = "Simpl DCP binding";
+    static final String SCOPE_SETTING = "simpl.dcp.membership.scope";
+    static final String DEFAULT_SCOPE = "org.eclipse.edc.vc.type:SimplDataspaceMembershipCredential:read";
+    static final String MEMBERSHIP_TYPE = "SimplDataspaceMembershipCredential";
+
+    @Inject
+    private PolicyEngine policyEngine;
+
+    private Monitor monitor;
+
+    @Override
+    public String name() {
+        return NAME;
+    }
+
+    @Override
+    public void initialize(ServiceExtensionContext context) {
+        monitor = context.getMonitor();
+        var scope = context.getSetting(SCOPE_SETTING, DEFAULT_SCOPE);
+        policyEngine.registerPostValidator(RequestCatalogPolicyContext.class, (p, c) -> addScope(c.requestScopeBuilder(), scope));
+        policyEngine.registerPostValidator(RequestContractNegotiationPolicyContext.class, (p, c) -> addScope(c.requestScopeBuilder(), scope));
+        policyEngine.registerPostValidator(RequestTransferProcessPolicyContext.class, (p, c) -> addScope(c.requestScopeBuilder(), scope));
+        policyEngine.registerPostValidator(RequestVersionPolicyContext.class, (p, c) -> addScope(c.requestScopeBuilder(), scope));
+        monitor.info("[SIMPL-DCP] DSP requests will require scope " + scope);
+    }
+
+    private static Boolean addScope(org.eclipse.edc.spi.iam.RequestScope.Builder builder, String scope) {
+        builder.scope(scope);
+        return true;
+    }
+
+    @Provider
+    public ClaimTokenCreatorFunction simplClaimTokenCreator() {
+        return credentials -> {
+            if (credentials == null || credentials.isEmpty()) {
+                return Result.failure("No VerifiableCredentials were found on VP");
+            }
+            var membership = credentials.stream().filter(SimplDcpExtension::isMembership).findFirst()
+                    .orElse(credentials.get(0));
+            var subjectId = membership.getCredentialSubject().stream().map(CredentialSubject::getId)
+                    .filter(id -> id != null && !id.isBlank()).findFirst().orElse(null);
+            var codes = new LinkedHashSet<String>();
+            membership.getCredentialSubject().forEach(s -> collectAttributes(s.getClaims(), false, codes));
+            var attributes = new ArrayList<IdentityAttribute>();
+            codes.forEach(code -> attributes.add(IdentityAttribute.builder().code(code).name(code).enabled(true).build()));
+            monitor.info("[SIMPL-DCP] verified " + String.join(",", membership.getType()) + " issued by "
+                    + membership.getIssuer().id() + " to " + subjectId + " -> identity_attributes=" + codes);
+
+            var builder = ClaimToken.Builder.newInstance()
+                    .claim("vc", credentials)
+                    .claim("identity_attributes", attributes);
+            if (subjectId != null) {
+                builder.claim("client_id", subjectId);
+            }
+            return Result.success(builder.build());
+        };
+    }
+
+    private static boolean isMembership(VerifiableCredential vc) {
+        return vc.getType() != null && vc.getType().stream().anyMatch(t -> t != null && t.endsWith(MEMBERSHIP_TYPE));
+    }
+
+    /**
+     * Collects identity attribute codes from credential subject claims. Accepts both compacted
+     * ({@code identityAttributes: ["CONSUMER"]}) and JSON-LD expanded forms
+     * ({@code https://.../identityAttributes: [{"@value": "CONSUMER"}]}).
+     */
+    private static void collectAttributes(Object node, boolean inAttributes, Set<String> out) {
+        if (node instanceof Map<?, ?> map) {
+            map.forEach((k, v) -> {
+                var key = String.valueOf(k);
+                var attrKey = inAttributes || key.toLowerCase().endsWith("identityattributes");
+                if ("@value".equals(key) && inAttributes && v != null) {
+                    out.add(String.valueOf(v));
+                } else {
+                    collectAttributes(v, attrKey, out);
+                }
+            });
+        } else if (node instanceof Collection<?> list) {
+            list.forEach(item -> collectAttributes(item, inAttributes, out));
+        } else if (node instanceof String s && inAttributes) {
+            out.add(s);
+        } else if (node != null && inAttributes && node.getClass().getName().startsWith("jakarta.json")) {
+            var text = node.toString().replace("\"", "");
+            if (!text.isBlank()) {
+                out.add(text);
+            }
+        }
+    }
+}
