+package eu.europa.ec.simpl.authenticationprovider.clients;
+
+import jakarta.validation.constraints.NotNull;
+
+public interface EbsiTrustAdapter {
+
+    /**
+     * Asks the EBSI trust service whether the Authority behind a {@code did:web} verification method is an
+     * accredited EBSI Trusted Issuer: it links a {@code did:ebsi} identity with a proof of control, and that
+     * identity is accredited in the EBSI Trusted Issuers Registry through a chain of signed accreditations up to a
+     * pinned Root TAO.
+     * @param verificationMethodId the verification method of the external Governance Authority, the issuer of the
+     *     credentials of its participants
+     * @return The outcome.
+     */
+    CheckIssuerOutcome checkIssuer(String verificationMethodId);
+
+    sealed interface CheckIssuerOutcome {
+
+        /**
+         * @param ebsiDid the {@code did:ebsi} the Authority proved it controls
+         */
+        record Trusted(@NotNull String ebsiDid) implements CheckIssuerOutcome {}
+
+        /**
+         * The service answered, and the issuer is not an accredited EBSI Trusted Issuer.
+         * @param reason for the logs only, never in a response
+         */
+        record NotTrusted(@NotNull String reason) implements CheckIssuerOutcome {}
+
+        /**
+         * The service or EBSI could not be reached, timed out, or answered something unreadable. The decision is
+         * never "trusted" then.
+         * @param reason for the logs only, never in a response
+         */
+        record Unavailable(@NotNull String reason) implements CheckIssuerOutcome {}
+    }
+}
