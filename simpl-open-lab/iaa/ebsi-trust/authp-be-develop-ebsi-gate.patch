@@ -0,0 +1,91 @@
+package eu.europa.ec.simpl.authenticationprovider.clients.impl;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import eu.europa.ec.simpl.authenticationprovider.clients.EbsiTrustAdapter;
+import eu.europa.ec.simpl.authenticationprovider.properties.EbsiProperties;
+import java.net.http.HttpClient;
+import lombok.extern.log4j.Log4j2;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.client.JdkClientHttpRequestFactory;
+import org.springframework.stereotype.Service;
+import org.springframework.web.client.HttpStatusCodeException;
+import org.springframework.web.client.RestClient;
+import org.springframework.web.client.RestClientException;
+
+@Log4j2
+@Service
+public class EbsiTrustAdapterImpl implements EbsiTrustAdapter {
+
+    private final EbsiProperties ebsiProperties;
+    private final ObjectMapper objectMapper;
+    private final RestClient restClient;
+
+    public EbsiTrustAdapterImpl(EbsiProperties ebsiProperties, ObjectMapper objectMapper) {
+        this.ebsiProperties = ebsiProperties;
+        this.objectMapper = objectMapper;
+        if (Boolean.TRUE.equals(ebsiProperties.enabled())) {
+            var factory = new JdkClientHttpRequestFactory(
+                    HttpClient.newBuilder().followRedirects(HttpClient.Redirect.NEVER).build());
+            factory.setReadTimeout(ebsiProperties.timeout());
+            this.restClient = RestClient.builder()
+                    .baseUrl(ebsiProperties.url().toString())
+                    .requestFactory(factory)
+                    .build();
+        } else {
+            this.restClient = null;
+        }
+    }
+
+    @Override
+    public CheckIssuerOutcome checkIssuer(String verificationMethodId) {
+        if (restClient == null) {
+            return new CheckIssuerOutcome.Unavailable("EBSI accreditation check is not enabled");
+        }
+        String body;
+        try {
+            body = restClient
+                    .get()
+                    .uri(uriBuilder ->
+                            uriBuilder.path("/check-web").queryParam("vm", "{vm}").build(verificationMethodId))
+                    .retrieve()
+                    .body(String.class);
+        } catch (HttpStatusCodeException e) {
+            if (e.getStatusCode().isSameCodeAs(HttpStatus.FORBIDDEN)) {
+                log.warn("EBSI trust service rejected issuer {}: {}", verificationMethodId, reason(e.getResponseBodyAsString()));
+                return new CheckIssuerOutcome.NotTrusted(reason(e.getResponseBodyAsString()));
+            }
+            log.warn("EBSI trust service answered {} for issuer {}", e.getStatusCode().value(), verificationMethodId);
+            return new CheckIssuerOutcome.Unavailable("The EBSI trust service answered %d".formatted(e.getStatusCode().value()));
+        } catch (RestClientException | IllegalArgumentException e) {
+            log.warn("EBSI trust service could not be reached for issuer {}", verificationMethodId, e);
+            return new CheckIssuerOutcome.Unavailable(String.valueOf(e.getMessage()));
+        }
+        if (body == null || body.isBlank()) {
+            // an empty answer, such as a redirect that was not followed, is not a decision
+            log.warn("EBSI trust service answered nothing for issuer {}", verificationMethodId);
+            return new CheckIssuerOutcome.Unavailable("Empty answer from the EBSI trust service");
+        }
+        try {
+            JsonNode answer = objectMapper.readTree(body);
+            // Only an explicit {"trusted": true, "ebsiDid": "did:ebsi:..."} is a pass; anything else is not.
+            if (answer.path("trusted").isBoolean()
+                    && answer.get("trusted").booleanValue()
+                    && answer.path("ebsiDid").asText("").startsWith("did:ebsi:")) {
+                return new CheckIssuerOutcome.Trusted(answer.get("ebsiDid").asText());
+            }
+            return new CheckIssuerOutcome.NotTrusted("The EBSI trust service did not confirm the issuer");
+        } catch (Exception e) {
+            log.warn("EBSI trust service answered something unreadable for issuer {}", verificationMethodId, e);
+            return new CheckIssuerOutcome.Unavailable("Unreadable answer from the EBSI trust service");
+        }
+    }
+
+    private String reason(String body) {
+        try {
+            return objectMapper.readTree(body).path("reason").asText("rejected");
+        } catch (Exception e) {
+            return "rejected";
+        }
+    }
+}
