+package eu.europa.ec.simpl.authenticationprovider.properties;
+
+import jakarta.validation.constraints.NotNull;
+import java.net.URI;
+import java.time.Duration;
+import org.springframework.boot.context.properties.ConfigurationProperties;
+import org.springframework.boot.context.properties.bind.DefaultValue;
+import org.springframework.validation.annotation.Validated;
+
+/**
+ * Optional EBSI accreditation gate for federated Tier 2 sessions. Kept apart from {@link SimplProperties}.
+ *
+ * @param enabled whether the issuer of a federated Tier 2 session must also be an accredited EBSI Trusted Issuer, on
+ *     top of the trust relation credential. Off by default
+ * @param url base URL of the EBSI trust service, required when enabled
+ * @param timeout how long to wait for the EBSI trust service: a cold accreditation chain walk against the EBSI pilot
+ *     took over a minute, a cached one milliseconds
+ */
+@ConfigurationProperties(prefix = "simpl.ebsi")
+@Validated
+public record EbsiProperties(
+        @DefaultValue("false") @NotNull Boolean enabled, URI url, @DefaultValue("90s") @NotNull Duration timeout) {
+
+    public EbsiProperties {
+        if (Boolean.TRUE.equals(enabled) && url == null) {
+            throw new IllegalArgumentException("simpl.ebsi.url is required when simpl.ebsi.enabled is true");
+        }
+    }
+}
