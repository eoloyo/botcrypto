+package eu.europa.ec.simpl.authenticationprovider.clients.impl;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.sun.net.httpserver.HttpServer;
+import eu.europa.ec.simpl.authenticationprovider.clients.EbsiTrustAdapter.CheckIssuerOutcome;
+import eu.europa.ec.simpl.authenticationprovider.properties.EbsiProperties;
+import java.net.InetSocketAddress;
+import java.net.URI;
+import java.net.URLDecoder;
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+import java.util.concurrent.atomic.AtomicReference;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+class EbsiTrustAdapterImplTest {
+
+    // a real did:web verification method: a port-encoded host, a path and a fragment
+    private static final String ISSUER = "did:web:authority.example%3A8443:gov#key-1";
+
+    private HttpServer server;
+    private final AtomicReference<String> rawRequest = new AtomicReference<>();
+    private int status;
+    private String body;
+    private String location;
+
+    @BeforeEach
+    void startServer() throws Exception {
+        server = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
+        server.createContext("/", exchange -> {
+            rawRequest.set(exchange.getRequestURI().getRawPath() + "?" + exchange.getRequestURI().getRawQuery());
+            if (location != null) {
+                exchange.getResponseHeaders().add("Location", location);
+            }
+            var bytes = body.getBytes(StandardCharsets.UTF_8);
+            exchange.sendResponseHeaders(status, status == 302 ? -1 : bytes.length);
+            if (status != 302) {
+                exchange.getResponseBody().write(bytes);
+            }
+            exchange.close();
+        });
+        server.start();
+        location = null;
+    }
+
+    @AfterEach
+    void stopServer() {
+        server.stop(0);
+    }
+
+    private EbsiTrustAdapterImpl adapter() {
+        return new EbsiTrustAdapterImpl(
+                new EbsiProperties(true, URI.create("http://127.0.0.1:" + server.getAddress().getPort()), Duration.ofSeconds(5)),
+                new ObjectMapper());
+    }
+
+    @Test
+    void checkIssuerGivenAnAccreditedIssuerShouldBeTrustedAndSendTheVerificationMethodIntact() {
+        status = 200;
+        body = "{\"trusted\":true,\"ebsiDid\":\"did:ebsi:zAuthority\",\"chain\":[]}";
+
+        var outcome = adapter().checkIssuer(ISSUER);
+
+        assertThat(outcome).isEqualTo(new CheckIssuerOutcome.Trusted("did:ebsi:zAuthority"));
+        var raw = rawRequest.get();
+        assertThat(raw).startsWith("/check-web?vm=");
+        // what the EBSI trust service decodes is exactly the verification method: '#' and '%3A' survive
+        assertThat(URLDecoder.decode(raw.substring("/check-web?vm=".length()), StandardCharsets.UTF_8))
+                .isEqualTo(ISSUER);
+    }
+
+    @Test
+    void checkIssuerGivenARejectionShouldBeNotTrustedWithTheReason() {
+        status = 403;
+        body = "{\"trusted\":false,\"reason\":\"EBSI identity link proof signature does not verify\"}";
+
+        assertThat(adapter().checkIssuer(ISSUER))
+                .isEqualTo(new CheckIssuerOutcome.NotTrusted("EBSI identity link proof signature does not verify"));
+    }
+
+    @Test
+    void checkIssuerGivenA200ThatDoesNotSayTrustedShouldNotBeTrusted() {
+        status = 200;
+        body = "{\"trusted\":false,\"ebsiDid\":\"did:ebsi:zAuthority\"}";
+
+        assertThat(adapter().checkIssuer(ISSUER)).isInstanceOf(CheckIssuerOutcome.NotTrusted.class);
+    }
+
+    // only an explicit trusted=true with a did:ebsi is a pass
+    @Test
+    void checkIssuerGivenTrustedWithoutAnEbsiDidShouldNotBeTrusted() {
+        status = 200;
+        body = "{\"trusted\":true,\"ebsiDid\":\"did:web:evil.example\"}";
+
+        assertThat(adapter().checkIssuer(ISSUER)).isInstanceOf(CheckIssuerOutcome.NotTrusted.class);
+    }
+
+    @Test
+    void checkIssuerGivenTrustedAsAStringShouldNotBeTrusted() {
+        status = 200;
+        body = "{\"trusted\":\"true\",\"ebsiDid\":\"did:ebsi:zAuthority\"}";
+
+        assertThat(adapter().checkIssuer(ISSUER)).isInstanceOf(CheckIssuerOutcome.NotTrusted.class);
+    }
+
+    @Test
+    void checkIssuerGivenAnUnavailableEbsiShouldBeUnavailableNeverTrusted() {
+        status = 503;
+        body = "{\"trusted\":false,\"reason\":\"unavailable\"}";
+
+        assertThat(adapter().checkIssuer(ISSUER)).isInstanceOf(CheckIssuerOutcome.Unavailable.class);
+    }
+
+    @Test
+    void checkIssuerGivenAServerErrorShouldBeUnavailable() {
+        status = 500;
+        body = "{}";
+
+        assertThat(adapter().checkIssuer(ISSUER)).isInstanceOf(CheckIssuerOutcome.Unavailable.class);
+    }
+
+    @Test
+    void checkIssuerGivenAnUnreadableAnswerShouldBeUnavailable() {
+        status = 200;
+        body = "<html>not json</html>";
+
+        assertThat(adapter().checkIssuer(ISSUER)).isInstanceOf(CheckIssuerOutcome.Unavailable.class);
+    }
+
+    @Test
+    void checkIssuerGivenARedirectShouldNotFollowItAndBeUnavailable() {
+        status = 302;
+        body = "";
+        location = "http://127.0.0.1:1/elsewhere";
+
+        assertThat(adapter().checkIssuer(ISSUER)).isInstanceOf(CheckIssuerOutcome.Unavailable.class);
+    }
+
+    @Test
+    void checkIssuerGivenNothingListeningShouldBeUnavailable() {
+        var adapter = adapter();
+        server.stop(0);
+
+        assertThat(adapter.checkIssuer(ISSUER)).isInstanceOf(CheckIssuerOutcome.Unavailable.class);
+    }
+
+    @Test
+    void checkIssuerGivenEbsiDisabledShouldBeUnavailableNeverTrusted() {
+        var disabled = new EbsiTrustAdapterImpl(new EbsiProperties(false, null, Duration.ofSeconds(5)), new ObjectMapper());
+
+        assertThat(disabled.checkIssuer(ISSUER)).isInstanceOf(CheckIssuerOutcome.Unavailable.class);
+    }
+
+    @Test
+    void ebsiPropertiesGivenEnabledWithoutAUrlShouldBeRejected() {
+        org.assertj.core.api.Assertions.assertThatThrownBy(() -> new EbsiProperties(true, null, Duration.ofSeconds(5)))
+                .isInstanceOf(IllegalArgumentException.class);
+    }
+}
